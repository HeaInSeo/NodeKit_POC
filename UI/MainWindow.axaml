<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NodeKit_POC.Models"
        x:Class="NodeKit_POC.UI.MainWindow"
        Title="NodeKit_POC — Tool Runtime Image Recipe"
        Width="1440"
        Height="960"
        MinWidth="1280"
        MinHeight="860"
        WindowStartupLocation="CenterScreen"
        Background="#08111F">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#07111E" BorderBrush="#16253F" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel Margin="24,28,18,24" Spacing="18">
          <StackPanel Spacing="6">
            <TextBlock Text="NodeKit_POC" Foreground="White" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Tool runtime image authoring slice" Classes="caption" />
          </StackPanel>

          <Border Classes="panel" Background="#101B2F">
            <StackPanel Spacing="10">
              <TextBlock Text="목표" Classes="section-title" FontSize="15" />
              <TextBlock Text="하나의 Tool을 하나의 컨테이너 이미지로 만들기 위한 설치/환경 recipe를 생성합니다."
                         Foreground="#D8E1F2"
                         TextWrapping="Wrap"
                         FontSize="12"/>
            </StackPanel>
          </Border>

          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Text="핵심 UX 원칙" Classes="section-title" FontSize="15" />
              <TextBlock Text="1. 한 화면에서 한 결정만" Foreground="#D8E1F2"/>
              <TextBlock Text="2. 검색어 하나로 후보까지 진입" Foreground="#D8E1F2"/>
              <TextBlock Text="3. 비교는 Explorer에서, 코드 확인은 Preview에서" Foreground="#D8E1F2"/>
              <TextBlock Text="4. Dockerfile은 안정적인 템플릿으로 생성" Foreground="#D8E1F2"/>
            </StackPanel>
          </Border>

          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Text="이미지 정책" Classes="section-title" FontSize="15" />
              <TextBlock Text="하나의 이미지 = 하나의 Primary Tool runtime" Classes="caption" TextWrapping="Wrap"/>
              <TextBlock Text="실행 command, script, entrypoint는 이후 wrapper 또는 DAG node 단계에서 정의" Classes="caption" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="20,0,20,20" Background="#0F1A2B" BorderBrush="#24304D" BorderThickness="1" CornerRadius="12" Padding="14">
          <StackPanel Spacing="6">
            <TextBlock Text="상태" Foreground="#8DA2C0" FontSize="11"/>
            <TextBlock Name="StatusText" Text="준비" Foreground="White" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#0A1425" BorderBrush="#16253F" BorderThickness="0,0,0,1" Padding="28,22">
        <StackPanel Spacing="8">
          <TextBlock Text="Tool Runtime Image 만들기" Foreground="White" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="하나의 Tool이 설치된 재사용 가능한 runtime image recipe를 만들고, 실제 실행 command는 이후 단계에서 정의합니다."
                     Foreground="#A9B7D2"
                     FontSize="13"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="28,24,28,28" Spacing="20">
          <Border Background="#0F1A2B" BorderBrush="#24304D" BorderThickness="1" CornerRadius="16" Padding="20">
            <Grid ColumnDefinitions="Auto,16,Auto,16,Auto">
              <StackPanel Grid.Column="0" Spacing="4">
                <Border Name="Step1Badge" Background="#2F67FF" CornerRadius="999" Width="32" Height="32">
                  <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="Mode" Foreground="White" FontWeight="SemiBold"/>
                <TextBlock Text="Connected / Disconnected" Classes="caption"/>
              </StackPanel>
              <Rectangle Grid.Column="1" Height="2" Fill="#24304D" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Spacing="4">
                <Border Name="Step2Badge" Background="#16253F" CornerRadius="999" Width="32" Height="32">
                  <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8DA2C0" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="Explore" Foreground="White" FontWeight="SemiBold"/>
                <TextBlock Text="source candidates" Classes="caption"/>
              </StackPanel>
              <Rectangle Grid.Column="3" Height="2" Fill="#24304D" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="4" Spacing="4">
                <Border Name="Step3Badge" Background="#16253F" CornerRadius="999" Width="32" Height="32">
                  <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8DA2C0" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="Preview" Foreground="White" FontWeight="SemiBold"/>
                <TextBlock Text="recipe drafts" Classes="caption"/>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Name="SelectionView" Spacing="20">
            <Border Classes="panel">
              <StackPanel Spacing="14">
                <TextBlock Text="1. 연결 모드" Classes="section-title"/>
                <Grid ColumnDefinitions="*,16,*">
                  <Button Name="DisconnectedModeButton" Grid.Column="0" Classes="subtle" Padding="18,16" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="6">
                      <TextBlock Text="오프라인 / 내부망" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="내부 seed, mirror, recipe bundle, 내부 registry를 기준으로 시작합니다." Classes="caption" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Button>
                  <Button Name="ConnectedModeButton" Grid.Column="2" Classes="subtle" Padding="18,16" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="6">
                      <TextBlock Text="외부 연결" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="Bioconda, GitHub Release, OCI Registry를 검색해 초안을 빠르게 만듭니다." Classes="caption" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Button>
                </Grid>
                <Border Background="#111D31" BorderBrush="#263A66" BorderThickness="1" CornerRadius="12" Padding="14">
                  <TextBlock Name="ModeHintText" Foreground="#D8E1F2" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                  <TextBlock Text="2. 시작점 선택" Classes="section-title"/>
                  <TextBlock Text="현재 모드에서 사용할 출발점을 고르세요. 추천 경로부터 바로 탐색할 수 있습니다." Classes="caption" TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Name="ConnectedStartPointsPanel" ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto">
                  <Button Name="BiocondaStartButton" Grid.Row="0" Grid.Column="0" Classes="subtle" Padding="18" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Conda / Bioconda에서 시작" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="패키지 이름과 버전을 기준으로 가장 빠르게 recipe 초안을 만듭니다." Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="권장 경로" Foreground="#8ED19A" FontSize="11"/>
                    </StackPanel>
                  </Button>

                  <Button Name="GitHubReleaseStartButton" Grid.Row="0" Grid.Column="2" Classes="subtle" Padding="18" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="8">
                      <TextBlock Text="GitHub Release에서 시작" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="release tag와 repository 정보를 기준으로 binary/source 출발점을 찾습니다." Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="보조 경로" Foreground="#8ED19A" FontSize="11"/>
                    </StackPanel>
                  </Button>

                  <Button Name="OciRegistryStartButton" Grid.Row="2" Grid.Column="0" Classes="subtle" Padding="18" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="8">
                      <TextBlock Text="OCI Image에서 시작" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="기존 image tag 또는 registry 후보를 runtime 출발점으로 사용합니다." Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="이미지 기반 경로" Foreground="#8ED19A" FontSize="11"/>
                    </StackPanel>
                  </Button>

                  <Button Name="AllExternalRoutesStartButton" Grid.Row="2" Grid.Column="2" Classes="subtle" Padding="18" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="8">
                      <TextBlock Text="외부 전체 후보 비교" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="Bioconda, GitHub Release, OCI Registry 후보를 한 화면에서 비교합니다." Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="탐색 중심" Foreground="#8ED19A" FontSize="11"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <Grid Name="DisconnectedStartPointsPanel" IsVisible="False" ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto">
                  <Button Name="InternalSeedStartButton" Grid.Row="0" Grid.Column="0" Classes="subtle" Padding="18" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="8">
                      <TextBlock Text="내부 시드 레시피에서 시작" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="검증된 내부 seed recipe를 출발점으로 사용합니다." Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="오프라인 기본 경로" Foreground="#8ED19A" FontSize="11"/>
                    </StackPanel>
                  </Button>

                  <Button Name="LocalMirrorStartButton" Grid.Row="0" Grid.Column="2" Classes="subtle" Padding="18" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="8">
                      <TextBlock Text="내부 패키지 미러에서 시작" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="내부 conda/bioconda mirror 또는 package cache를 기준으로 시작합니다." Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="mirror 경로" Foreground="#8ED19A" FontSize="11"/>
                    </StackPanel>
                  </Button>

                  <Button Name="RecipeBundleStartButton" Grid.Row="2" Grid.Column="0" Classes="subtle" Padding="18" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Recipe Bundle 가져오기" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="미리 반입된 recipe bundle을 선택해 시작합니다." Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="반입 경로" Foreground="#8ED19A" FontSize="11"/>
                    </StackPanel>
                  </Button>

                  <Button Name="InternalRegistryStartButton" Grid.Row="2" Grid.Column="2" Classes="subtle" Padding="18" HorizontalContentAlignment="Left">
                    <StackPanel Spacing="8">
                      <TextBlock Text="내부 Harbor / Registry에서 시작" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                      <TextBlock Text="내부 registry의 기존 runtime image를 출발점으로 사용합니다." Classes="caption" TextWrapping="Wrap"/>
                      <TextBlock Text="registry 경로" Foreground="#8ED19A" FontSize="11"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Name="ExplorerView" IsVisible="False" Spacing="20">
            <Border Classes="panel">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="10">
                  <TextBlock Text="Source Explorer" Classes="section-title"/>
                  <WrapPanel Orientation="Horizontal">
                    <Border Background="#132542" CornerRadius="999" Padding="12,7" Margin="0,0,8,8">
                      <TextBlock Name="ExplorerModeChipText" Foreground="White"/>
                    </Border>
                    <Border Background="#132542" CornerRadius="999" Padding="12,7" Margin="0,0,8,8">
                      <TextBlock Name="ExplorerRouteChipText" Foreground="White"/>
                    </Border>
                    <Border Background="#132542" CornerRadius="999" Padding="12,7" Margin="0,0,8,8">
                      <TextBlock Name="ExplorerSearchChipText" Foreground="White"/>
                    </Border>
                  </WrapPanel>
                </StackPanel>
                <Button Name="BackToSelectionButton" Grid.Column="1" Classes="subtle" Padding="14,10">이전으로</Button>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="2.2*,16,1.1*">
              <StackPanel Grid.Column="0" Spacing="16">
                <Border Classes="panel">
                  <StackPanel Spacing="14">
                    <TextBlock Text="검색 또는 탐색" Classes="section-title"/>
                    <TextBox Name="SearchBox"
                             PlaceholderText="예: bwa, samtools, gatk, fastqc"
                             Text="bwa"
                             Background="#0D1526"
                             BorderBrush="#263A66"
                             BorderThickness="1"
                             Foreground="White"
                             Padding="12"/>

                    <WrapPanel Name="ConnectedFiltersPanel" Orientation="Horizontal">
                      <Button Name="BiocondaFilterButton" Classes="subtle" Padding="10,6" Margin="0,0,8,8">Bioconda</Button>
                      <Button Name="GitHubReleaseFilterButton" Classes="subtle" Padding="10,6" Margin="0,0,8,8">GitHub Release</Button>
                      <Button Name="OciRegistryFilterButton" Classes="subtle" Padding="10,6" Margin="0,0,8,8">OCI Registry</Button>
                      <Button Name="AllExternalFilterButton" Classes="subtle" Padding="10,6" Margin="0,0,8,8">전체 외부</Button>
                    </WrapPanel>

                    <WrapPanel Name="DisconnectedFiltersPanel" IsVisible="False" Orientation="Horizontal">
                      <Button Name="InternalSeedFilterButton" Classes="subtle" Padding="10,6" Margin="0,0,8,8">Internal Seed</Button>
                      <Button Name="LocalMirrorFilterButton" Classes="subtle" Padding="10,6" Margin="0,0,8,8">Local Mirror</Button>
                      <Button Name="RecipeBundleFilterButton" Classes="subtle" Padding="10,6" Margin="0,0,8,8">Recipe Bundle</Button>
                      <Button Name="InternalRegistryFilterButton" Classes="subtle" Padding="10,6" Margin="0,0,8,8">Internal Registry</Button>
                    </WrapPanel>

                    <TextBlock Name="ExplorerHintText" Classes="caption" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <Border Classes="panel">
                  <StackPanel Spacing="12">
                    <TextBlock Name="CandidatesHeaderText" Text="후보 목록" Classes="section-title"/>
                    <Border Name="EmptyCandidatesPanel" IsVisible="False" Background="#111D31" BorderBrush="#263A66" BorderThickness="1" CornerRadius="12" Padding="14">
                      <TextBlock Name="EmptyCandidatesText" Foreground="#D8E1F2" TextWrapping="Wrap"/>
                    </Border>

                    <ListBox Name="CandidatesListBox" Background="Transparent" BorderThickness="0" Foreground="White">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolSourceCandidate">
                          <Border Background="#0D1526" BorderBrush="#263A66" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="6">
                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SourceLabel}" Foreground="#A9B7D2"/>
                                <WrapPanel Orientation="Horizontal">
                                  <Border Background="#132542" CornerRadius="999" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding RouteLabel}" Foreground="#85AFFF" FontSize="11"/>
                                  </Border>
                                  <Border Background="#132542" CornerRadius="999" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding ConnectivityLabel}" Foreground="#D8E1F2" FontSize="11"/>
                                  </Border>
                                  <Border Background="#14311F" CornerRadius="999" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding RecommendationLabel}" Foreground="#8ED19A" FontSize="11"/>
                                  </Border>
                                </WrapPanel>
                              </StackPanel>

                              <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                                <Border Background="#111D31" BorderBrush="#263A66" BorderThickness="1" CornerRadius="999" Padding="12,6">
                                  <TextBlock Text="{Binding Version}" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding StableRef}" Foreground="#8DA2C0" FontFamily="Monospace" FontSize="11" HorizontalAlignment="Right"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="16">
                <Border Classes="panel">
                  <StackPanel Spacing="14">
                    <TextBlock Text="선택 항목 미리보기" Classes="section-title"/>
                    <StackPanel Spacing="6">
                      <TextBlock Name="PreviewTitleText" Text="후보를 선택하세요." Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                      <TextBlock Name="PreviewSubtitleText" Classes="caption" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                      <TextBlock Grid.Row="0" Text="Route" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" Name="PreviewRouteText" Foreground="White"/>
                      <TextBlock Grid.Row="1" Text="Version" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Name="PreviewVersionText" Foreground="White"/>
                      <TextBlock Grid.Row="2" Text="StableRef" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Name="PreviewStableRefText" Foreground="White" FontFamily="Monospace"/>
                      <TextBlock Grid.Row="3" Text="외부 연결" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" Name="PreviewConnectivityText" Foreground="White"/>
                      <TextBlock Grid.Row="4" Text="패키지/채널" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" Name="PreviewPackageText" Foreground="White"/>
                      <TextBlock Grid.Row="5" Text="생성 예정" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="5" Grid.Column="1" Name="PreviewOutputsText" Foreground="#D8E1F2" TextWrapping="Wrap"/>
                    </Grid>

                    <Border Background="#111D31" BorderBrush="#263A66" BorderThickness="1" CornerRadius="12" Padding="14">
                      <TextBlock Name="PreviewHintText" Foreground="#D8E1F2" TextWrapping="Wrap"/>
                    </Border>
                  </StackPanel>
                </Border>

                <Button Name="OpenRecipePreviewButton" Classes="primary" Padding="16,12" IsEnabled="False">
                  Recipe Preview 보기
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel Name="RecipePreviewView" IsVisible="False" Spacing="20">
            <Border Classes="panel">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="10">
                  <TextBlock Text="Recipe Preview" Classes="section-title"/>
                  <TextBlock Text="정규화된 ToolInstallRecipe와 generated runtime image recipe를 확인합니다."
                             Classes="caption"
                             TextWrapping="Wrap"/>
                </StackPanel>
                <Button Name="BackToExplorerButton" Grid.Column="1" Classes="subtle" Padding="14,10">탐색으로 돌아가기</Button>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="1.1*,16,1.4*">
              <StackPanel Grid.Column="0" Spacing="16">
                <Border Classes="panel">
                  <StackPanel Spacing="14">
                    <TextBlock Text="정규화 요약" Classes="section-title"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                      <TextBlock Grid.Row="0" Text="Tool" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" Name="RecipeToolText" Foreground="White"/>
                      <TextBlock Grid.Row="1" Text="Version" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Name="RecipeVersionText" Foreground="White"/>
                      <TextBlock Grid.Row="2" Text="Primary Tool" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Name="RecipePrimaryToolText" Foreground="White"/>
                      <TextBlock Grid.Row="3" Text="Mode" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" Name="RecipeModeText" Foreground="White"/>
                      <TextBlock Grid.Row="4" Text="Source Route" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" Name="RecipeRouteText" Foreground="White"/>
                      <TextBlock Grid.Row="5" Text="Install Method" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="5" Grid.Column="1" Name="RecipeInstallMethodText" Foreground="White"/>
                      <TextBlock Grid.Row="6" Text="StableRef" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="6" Grid.Column="1" Name="RecipeStableRefText" Foreground="White" FontFamily="Monospace"/>
                      <TextBlock Grid.Row="7" Text="Recipe Version" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="7" Grid.Column="1" Name="RecipeVersionTagText" Foreground="White"/>
                      <TextBlock Grid.Row="8" Text="Recipe Fingerprint" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="8" Grid.Column="1" Name="RecipeFingerprintText" Foreground="White" TextWrapping="Wrap"/>
                      <TextBlock Grid.Row="9" Text="Fingerprint Seed" Foreground="#8DA2C0"/>
                      <TextBlock Grid.Row="9" Grid.Column="1" Name="RecipeReproSeedText" Foreground="White" TextWrapping="Wrap"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="panel">
                  <StackPanel Spacing="10">
                    <TextBlock Text="이미지 정책" Classes="section-title"/>
                    <TextBlock Name="RuntimePolicyText" Foreground="#D8E1F2" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <Border Classes="panel">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Primary Tool Package" Classes="section-title"/>
                    <TextBox Name="RecipePackagesBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Height="120"
                             TextWrapping="Wrap"
                             FontFamily="Monospace"
                             Background="#0D1526"
                             BorderBrush="#263A66"
                             Foreground="#D8E1F2"/>
                  </StackPanel>
                </Border>

                <Border Classes="panel">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Resolved Dependencies" Classes="section-title"/>
                    <TextBox Name="ResolvedDependenciesBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Height="90"
                             TextWrapping="Wrap"
                             FontFamily="Monospace"
                             Background="#0D1526"
                             BorderBrush="#263A66"
                             Foreground="#D8E1F2"/>
                  </StackPanel>
                </Border>

                <Border Classes="panel">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Lock Metadata Preview" Classes="section-title"/>
                    <TextBox Name="LockMetadataBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Height="180"
                             TextWrapping="Wrap"
                             FontFamily="Monospace"
                             Background="#0D1526"
                             BorderBrush="#263A66"
                             Foreground="#D8E1F2"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="16">
                <Border Classes="panel">
                  <StackPanel Spacing="10">
                    <TextBlock Text="environment.yml" Classes="section-title"/>
                    <TextBox Name="EnvironmentYamlPreviewBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Height="180"
                             TextWrapping="Wrap"
                             FontFamily="Monospace"
                             Background="#0D1526"
                             BorderBrush="#263A66"
                             Foreground="#D8E1F2"/>
                  </StackPanel>
                </Border>

                <Border Classes="panel">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Multi-stage Dockerfile" Classes="section-title"/>
                    <TextBox Name="DockerfilePreviewBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Height="420"
                             TextWrapping="Wrap"
                             FontFamily="Monospace"
                             Background="#0D1526"
                             BorderBrush="#263A66"
                             Foreground="#D8E1F2"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
