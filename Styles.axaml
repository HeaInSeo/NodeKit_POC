<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="#8DA2C0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#2F67FF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#4D85FF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="#161C2E" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#283250" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="#0F1424" />
    <Setter Property="BorderBrush" Value="#24304D" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>
</Styles>
